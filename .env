# =========================
# Ports
# =========================
AUTH_SERVER_PORT=8082
AUDIO_SERVER_PORT=8083
PRONUNCIATION_SERVER_PORT=8084
ANGULAR_PORT=4200
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432

# =========================
# Service URLs - Docker network
# =========================
AUTH_SERVICE_URL=http://auth-service:8082
AUDIO_SERVICE_URL=http://audio-services:8083
PRONUNCIATION_SERVICE_URL=http://pronunciation-service:8084

# =========================
# Database - Postgres
# =========================
POSTGRES_DB=audiodb
POSTGRES_USER=audio
POSTGRES_PASSWORD=audio123

# Audio service datasource
AUDIO_DB_URL=jdbc:postgresql://postgres:5432/audiodb
AUDIO_DB_USERNAME=audio
AUDIO_DB_PASSWORD=audio123

# Optional: auth/pronunciation DBs if later moved to Postgres
AUTH_DB_URL=jdbc:h2:file:./data/authdb
AUTH_DB_USERNAME=sa
AUTH_DB_PASSWORD=

PRONUNCIATION_DB_URL=jdbc:h2:file:./data/pronunciationdb
PRONUNCIATION_DB_USERNAME=sa
PRONUNCIATION_DB_PASSWORD=

# =========================
# JPA
# =========================
JPA_DDL_AUTO=update
SHOW_SQL=true

# =========================
# JWT
# =========================
JWT_EXPIRATION_MS=600000
JWT_JWKS_URI=http://auth-service:8082/.well-known/jwks.json
JWT_PUBLIC_KEY_PATH=classpath:public.key
JWT_PRIVATE_KEY_PATH=classpath:private.key

# =========================
# MinIO
# =========================
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_WORD_BUCKET=wordbucket
MINIO_SENTENCE_BUCKET=sentencebucket
